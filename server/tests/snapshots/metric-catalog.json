  "quadrant_presets": [
    {
      "cohort_note": "Commits are counted per file",
      "cohorts": [
        "file"
      ],
      "description": "Complex files that keep changing are where a refactor pays off first.",
      "id": "activity",
      "label": "Activity",
      "quadrants": [
        {
          "description": "Complex and changing often: refactor first.",
          "id": "high_both",
          "name": "Hot mess"
        },
        {
          "description": "Complex but rarely touched: leave it until it wakes.",
          "id": "high_x",
          "name": "Sleeping giant"
        },
        {
          "description": "Changes often and stays simple.",
          "id": "high_y",
          "name": "Busy, fine"
        },
        {
          "description": "Simple and stable.",
          "id": "low_both",
          "name": "Quiet"
        }
      ],
      "x": {
        "cutoff": 10,
