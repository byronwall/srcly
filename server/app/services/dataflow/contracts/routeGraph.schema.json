        "partial",
        "not-analyzed",
        "unsupported",
        "stale",
        "cancelled",
        "budget"
      ]
    },
    "generation": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "programHash": {
      "type": "string"
    },
    "tsconfig": {
      "type": "string"
    },
    "typescript": {
      "type": "string"
