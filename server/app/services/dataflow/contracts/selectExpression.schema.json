{
  "title": "SelectExpressionResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "ok",
        "assumed",
        "partial",
        "not-analyzed",
        "unsupported",
        "stale",
        "cancelled",
        "budget"
      ]
    },
    "generation": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "programHash": {
      "type": "string"
    },
    "tsconfig": {
      "type": "string"
    },
    "typescript": {
      "type": "string"
    },
    "file": {
      "type": "string"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "span": {
            "type": "object",
            "properties": {
              "startLine": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "startColumn": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "endLine": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "endColumn": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "startLine",
              "startColumn",
              "endLine",
              "endColumn"
            ],
            "additionalProperties": false
          },
          "evidence": {
            "type": "boolean"
          }
        },
        "required": [
          "kind",
          "text",
          "span",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "outcome",
    "generation",
    "programHash",
    "tsconfig",
    "typescript",
    "file",
    "reason",
    "candidates"
  ],
  "additionalProperties": false
}
