{
  "title": "SymbolRefsResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "ok",
        "assumed",
        "partial",
        "not-analyzed",
        "unsupported",
        "stale",
        "cancelled",
        "budget"
      ]
    },
    "generation": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "programHash": {
      "type": "string"
    },
    "tsconfig": {
      "type": "string"
    },
    "typescript": {
      "type": "string"
    },
    "nullProof": {
      "type": "boolean"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "meaning": {
            "type": "string",
            "enum": [
              "value",
              "type"
            ]
          },
          "scope": {
            "type": "string",
            "enum": [
              "module",
              "member",
              "local"
            ]
          }
        },
        "required": [
          "file",
          "name",
          "line",
          "meaning",
          "scope"
        ],
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "line": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "column": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "endColumn": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "call",
                    "instantiate",
                    "read",
                    "write",
                    "type",
                    "extends",
                    "implements"
                  ]
                },
                "source": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "target": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "unbound": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "unresolved",
                        "any"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "line",
                "column",
                "endColumn",
                "kind",
                "source",
                "target",
                "unbound"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "file",
          "refs"
        ],
        "additionalProperties": false
      }
    },
    "counts": {
      "type": "object",
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "bound": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unbound": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "external": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "files",
        "bound",
        "unbound",
        "external"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "outcome",
    "generation",
    "programHash",
    "tsconfig",
    "typescript",
    "nullProof",
    "reason",
    "targets",
    "files",
    "counts"
  ],
  "additionalProperties": false
}
