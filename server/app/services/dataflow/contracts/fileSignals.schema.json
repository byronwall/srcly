{
  "title": "FileSignalsResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "ok",
        "assumed",
        "partial",
        "not-analyzed",
        "unsupported",
        "stale",
        "cancelled",
        "budget"
      ]
    },
    "generation": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "programHash": {
      "type": "string"
    },
    "tsconfig": {
      "type": "string"
    },
    "typescript": {
      "type": "string"
    },
    "nullProof": {
      "type": "boolean"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "metrics": {
            "type": "object",
            "properties": {
              "impossibleDefenses": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "relayHops": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "fanOut": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "representationChanges": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "pathDepth": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "impossibleDefenses",
              "relayHops",
              "fanOut",
              "representationChanges",
              "pathDepth"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "file",
          "metrics"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": {
            "type": "string",
            "enum": [
              "impossible-defense",
              "repeated-fork",
              "context-relay",
              "broad-prop-bundle"
            ]
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "column": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "endLine": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "rule",
          "file",
          "line",
          "column",
          "endLine",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "unplacedDefenses": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "markdown": {
      "type": "string"
    }
  },
  "required": [
    "outcome",
    "generation",
    "programHash",
    "tsconfig",
    "typescript",
    "nullProof",
    "reason",
    "files",
    "findings",
    "unplacedDefenses",
    "markdown"
  ],
  "additionalProperties": false
}
