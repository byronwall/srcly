{
  "title": "StatusResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "built": {
      "type": "boolean"
    },
    "generation": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "programHash": {
      "type": [
        "string",
        "null"
      ]
    },
    "currentHash": {
      "type": [
        "string",
        "null"
      ]
    },
    "stale": {
      "type": "boolean"
    },
    "rssBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "progress": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "phase": {
              "type": "string",
              "enum": [
                "queued",
                "program",
                "identity",
                "trace",
                "summarize",
                "routes",
                "project"
              ]
            },
            "message": {
              "type": "string"
            },
            "completed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "phase",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "protocol",
    "built",
    "generation",
    "programHash",
    "currentHash",
    "stale",
    "rssBytes",
    "progress"
  ],
  "additionalProperties": false
}
