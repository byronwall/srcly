{
  "name": "@srcly/engine",
  "private": true,
  "version": "0.0.0",
  "description": "srcly's data-flow engine: the tsx-data-flow analysis behind a stdio protocol.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "accept:route-field-proof": "node --import tsx scripts/accept-route-field-proof.ts",
    "emit-contracts": "node --import tsx scripts/emit-contracts.ts",
    "capture-route-graph": "node --import tsx scripts/capture-route-graph.ts",
    "capture-anchor-graph": "node --import tsx scripts/capture-anchor-graph.ts"
  },
  "dependencies": {
    "typescript": "5.9.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "solid-js": "^1.9.17",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.0",
    "vitest": "^2.1.9"
  }
}
