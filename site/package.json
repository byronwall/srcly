{
  "name": "srcly-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build && vite build --ssr src/server.tsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "lucide-solid": "^1.49.0",
    "marked": "^17.0.6",
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-solid": "^2.11.15"
  }
}
