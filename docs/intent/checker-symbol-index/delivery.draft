diagram "How the plan is delivered" version=1
subtitle "M0 decides go or stop; each later milestone gets Codex review"

node approve "Byron approves\nPR 487"
node m0 "M0 cost spike\nvisual-notes + srcly" color=amber
node stop "Stop\nrecord numbers, keep limits" color=red
node m1 "M1 symbolRefs op\ncontract, mirror, route, fixtures" color=blue
node m2 "M2 Python merge\nbinder info, programHash cache" color=blue
node compare "compare_binders.py\nsrcly + explorEDA" color=amber
node fix "Fix mapping bugs" color=red
node m3 "M3 position lookup\nPlaywright lands on @type" color=blue
node review "Codex review loop\nup to 3 rounds, no P0 or P1" color=blue
node ship "Checker-bound refs\nretire the plan folder" color=green

legend amber "Gate"
legend blue "Build step"
legend green "Outcome"
legend red "Stop or fix"
legend line dashed "Failure path"
legend line solid "Happy path"

edge a approve -> m0
edge pass m0 -> m1 "gate passes"
edge fail m0 -> stop "gate fails" kind=async
edge b m1 -> m2
edge c m2 -> compare "proves"
edge ok compare -> m3 "0 mismatched keys"
edge bad compare -> fix "unexplained rows" kind=async
edge rerun fix -> compare "re-run" kind=async
edge d m3 -> review
edge e review -> ship "clean"

layout root engine=layered fit=slide
