diagram "Checker-bound symbol index" version=1
subtitle "The checker binds names; tree-sitter keeps the ids"

node plan "Checker-bound\nsymbol index"

node goals "Goals"
node g_members "Bind member calls\n~8,100 guessed refs in srcly"
node g_486 "Close #486 findings\n4 of 5 fully"
node g_ids "Keep every id\nfile#Name, file#Name@type"
node g_unbound "Unbound stays unresolved\ncounted by reason"

node design "Design"
node d_op "symbolRefs engine op\nspan, kind, source, target"
node d_key "Join key\nfile, line, name, meaning"
node d_pos "Show references by position\n/api/symbols/at"
node d_fallback "Tree-sitter fallback\nno Node, crash, memory-limit"
node d_imports "Imports graph stays tree-sitter\nbase scan never waits"

node proof "Proof"
node p_gate "M0 cost gate\nvisual-notes: at most 20 s, under 2,560 MB"
node p_compare "compare_binders.py\nevery TS ref, srcly + explorEDA"
node p_keys "0 mismatched keys\nexported and top-level"
node p_fixtures "#486 fixtures pass\nin both modes"

edge e1 plan -> goals
edge e2 goals -> g_members
edge e3 goals -> g_486
edge e4 goals -> g_ids
edge e5 goals -> g_unbound
edge e6 plan -> design
edge e7 design -> d_op
edge e8 design -> d_key
edge e9 design -> d_pos
edge e10 design -> d_fallback
edge e11 design -> d_imports
edge e12 plan -> proof
edge e13 proof -> p_gate
edge e14 proof -> p_compare
edge e15 proof -> p_keys
edge e16 proof -> p_fixtures

layout root mindmap root=plan
