diagram "Solid's For is five lines"
subtitle "We hand-code 128 lines for components Solid builds from two primitives"

node src "solid-js/dist/solid.js" shape=code lang=js numbers=on start=1448 <<JS
function For(props) {
  const fallback = "fallback" in props && {
    fallback: () => props.fallback
  };
  return createMemo(mapArray(() => props.each, props.children, fallback || undefined));
}
function Index(props) {
  const fallback = "fallback" in props && {
    fallback: () => props.fallback
  };
  return createMemo(indexArray(() => props.each, props.children, fallback || undefined));
}
JS
range src.for lines=1452 color=amber
range src.idx lines=1458 color=amber

node ours "srcly today: 128 lines\nconnectSolidFor 82, connectSolidShow 46\nmatch For and Show by name" color=orange shade=300

node prims "Two primitives [1]\ncreateMemo · mapArray or indexArray" color=mint

