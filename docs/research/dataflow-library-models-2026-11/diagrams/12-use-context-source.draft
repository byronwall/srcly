diagram "useContext: what the source says"
subtitle "The provider's value comes first; the default only when none exists"

node src "solid-js/dist/solid.js (reformatted)" shape=code lang=js numbers=on start=558 <<JS
function createContext(defaultValue, options) {
  const id = Symbol("context");
  return { id, Provider: createProvider(id), defaultValue };
}
function useContext(context) {
  let value;
  return Owner && Owner.context &&
    (value = Owner.context[context.id])
      !== undefined
      ? value
      : context.defaultValue;
}
JS
